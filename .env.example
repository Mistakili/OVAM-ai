# OVAM AI voice stack
ASSEMBLYAI_API_KEY=your_key_here
ASSEMBLYAI_AGENT_ID=your_agent_id_here

# Text fallback and the voice brain
GEMINI_API_KEY=your_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it

# Public voice brain. AssemblyAI calls {GEMMA_VOICE_BASE_URL}/chat/completions.
# Leave both blank to keep the managed voice model.
GEMMA_VOICE_BASE_URL=https://your-deployment.vercel.app/api
GEMMA_VOICE_TOKEN=a_long_random_string
